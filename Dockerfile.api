FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STOCKPRO_ENV=production \
    STOCKPRO_HOSTED_READ_ONLY=1 STOCKPRO_ENABLE_LOCAL_OPERATOR=0 \
    STOCKPRO_DATA_ROOT=/app/data/prospective_automation \
    STOCKPRO_EVIDENCE_MANIFEST=/app/data/EVIDENCE_MIRROR_MANIFEST.json \
    XDG_CACHE_HOME=/tmp/stockpro-cache PORT=8000
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt ./
RUN pip install --no-cache-dir --only-binary=:all: -r requirements-api.txt

# Private data are never copied into the image. Mount a verified mirror at /app/data:ro.
COPY api ./api
COPY application ./application
COPY core ./core
COPY research ./research
COPY config ./config
COPY models ./models
COPY reports ./reports
COPY scripts/evidence_mirror.py ./scripts/evidence_mirror.py
RUN mkdir -p /app/data && useradd --system --uid 10001 --home /app stockpro \
    && chown -R stockpro:stockpro /app
USER stockpro
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
