# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml itself is gitignored — this .example file is the only
# one that gets committed, so nobody accidentally leaks a real key.
#
# Everything below is OPTIONAL. The app works fully without any of it —
# these only activate the Phase 2 "better data" upgrade path.

# Polygon.io — https://polygon.io/dashboard/signup (unlimited historical, free)
# POLYGON_API_KEY = "your_key_here"

# Tiingo — https://tiingo.com/account/profile (500 req/hour, free)
# TIINGO_API_KEY = "your_key_here"
