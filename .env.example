# Backend variables are read from the process environment; this file is an example only.
STOCKPRO_ENV=development
STOCKPRO_CORS_ORIGINS=http://127.0.0.1:3000
STOCKPRO_ENABLE_LOCAL_OPERATOR=0
# STOCKPRO_SEC_USER_AGENT=Your organization and contact address for SEC requests
# STOCKPRO_DATA_ROOT=/path/to/private/persistent/storage
# STOCKPRO_API_TOKEN=Set through a secret manager if read authentication is required
# STOCKPRO_OPERATOR_TOKEN=Set through a secret manager for a separately protected operator
